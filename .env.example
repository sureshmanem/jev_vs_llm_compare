# One OpenRouter key covers everything: Jev (~typesafe/jev-latest) and the LLMs.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: call Jev directly at api.typesafe.ai instead (wins if set).
# TYPESAFE_API_KEY=
# Optional: pin a Jev version instead of the latest alias.
# TYPESAFE_DEFAULT_MODEL=

# LangSmith tracing (applies to all engines)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jev-vs-llm-compare
